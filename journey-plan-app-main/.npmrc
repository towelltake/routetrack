# Native modules (better-sqlite3, keytar) misbehave under pnpm's symlinked
# node_modules layout when Electron tries to rebuild them. Hoist to a flat
# layout to match what electron-builder expects.
node-linker=hoisted
shamefully-hoist=true

# Allow native module postinstall scripts (better-sqlite3, keytar) to run.
auto-install-peers=true
strict-peer-dependencies=false
