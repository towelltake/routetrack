{
  "name": "@journey/app",
  "version": "0.1.0",
  "private": true,
  "description": "Electron + React desktop shell for the Journey Plan App.",
  "main": "./out/main/index.js",
  "author": "Towell Group",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "test:smoke": "electron scripts/smoke-import.cjs",
    "icon": "node scripts/build-icon.cjs",
    "dist": "electron-vite build && electron-builder --win --config electron-builder.yml",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/inter": "^5.2.8",
    "better-sqlite3": "^11.5.0",
    "exceljs": "^4.4.0",
    "leaflet": "^1.9.4",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.0.1",
    "recharts": "^3.8.1",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@journey/shared": "workspace:*",
    "@types/better-sqlite3": "^7.6.12",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.34.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
