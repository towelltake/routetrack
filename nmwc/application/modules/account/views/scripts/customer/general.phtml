	    $('select').trigger('liszt:updated');
	}	
    });
    
    $('#btnload').click(function(){			
	var val = $("#ddltempl").val();
	if(val > 0) {
	    window.location = '<?php echo $url;?>/id/'+val+'/tmpl/1';
	}
    });
    
    
    <?php
    if($this->formdata['rdofftype'] != 3)
    {
	echo '$("#ddlhead_off").attr("disabled",true);';
	echo ' ';
	echo '$("#ddlhead_off").removeClass("required");';
	echo ' ';
	echo '$("select").trigger("liszt:updated");';	
    }
	if($this->formdata['rdofftype'] == 2)
	{
		echo   '$("#ddlhead_off").attr("disabled",false);
				$("#ddlhead_off").addClass("required");
				$("select").trigger("liszt:updated");';
	}
    ?>
    <?php echo $this->formdata['ddl_ar_cust'] == '1' ? '$("#txt_bill_to_bill").attr("readonly",false);' : '$("#txt_bill_to_bill").attr("readonly",true);' ; ?>
    
    $('#ddlinvo_pay').change(function() {
	
	if($("#ddlinvo_pay").val() == '0' || $("#ddlinvo_pay").val() == '1' )
	{ 
	    $("#txtcr_limit").val(0);
	    $("#txtcr_days").val(0);
	    $('#txt_bill_to_bill').val(0);
	    $('#ddl_ar_cust').val(0);
	    $('#txtcr_limit').attr('readonly',true);
	    $('#txtcr_days').attr('readonly',true);
	    $('#txt_bill_to_bill').attr('readonly',true);	    
	    $('#ddl_ar_cust').attr('disabled',true);
	}
	else
	{
	    $('#txt_bill_to_bill').attr('readonly',false);
	    $('#txtcr_limit').attr('readonly',false);
	    $('#txtcr_days').attr('readonly',false);
	    $('#ddl_ar_cust').attr('disabled',false);
	}	
	$('select').trigger('liszt:updated'); 
    });
    
	$('#ddlroutename').change(function(){
	
		$('#txtcode').val('');
		var routeid = $('#ddlroutename').val();
		var  url = base_url+'/account/customer/getcustomercode/route_code/'+routeid;
		$.ajax({
			url:url,			
			type:'post',		
			success:function(data) {
				$('#txtcode').val(data);
				<?php if($this->params['tmpl'] == 1 ) { ?>
				$('#txtbarcode').val(data);
				<?php } ?>
			}
		})	
	});
	
	$('#chkroundnetamt').click(function() {
		
		var dx = $('#chkroundnetamt').is(':checked');
		if(!dx)
		{
			$("#txtroundingoff").val($("#hdntxtroundingoff").val());
			$("#txtroundingoff").removeAttr('readonly');
		}
		else {
			$("#txtroundingoff").val(0);
			$("#txtroundingoff").attr('readonly','readonly');
		}
	});
	<?php if($this->formdata['chkroundnetamt']) { ?>
		$("#txtroundingoff").removeAttr('readonly');
	<?php } ?>
	
    <?php if($this->formdata['ddlinvo_pay'] == '0' || $this->formdata['ddlinvo_pay'] == '1') { ?>
	$("#txtcr_limit").val(0);
	$("#txtcr_days").val(0);
	$('#txt_bill_to_bill').val(0);
	$('#ddl_ar_cust').val(0);
	$('#txt_bill_to_bill').attr('readonly',true);
	$('#txtcr_limit').attr('readonly',true);
	$('#txtcr_days').attr('readonly',true);
	$('#ddl_ar_cust').attr('disabled',true);
	$('select').trigger('liszt:updated'); 
    <?php } ?>
})

