<script type="text/javascript">
$(document).ready(function() {
	
    $("#rdofftype").change(function()
    { 
	if($(this).val() == '2'){
	    $("#ddlhead_off").attr('disabled',false);
	    $("#ddlhead_off").addClass('required');
	    $('select').trigger('liszt:updated');
	}
	else
	{
	    $("#ddlhead_off").val('');
	    $("#ddlhead_off").attr('disabled',true);
	    $("#ddlhead_off").removeClass('required');
