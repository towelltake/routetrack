	$('#chkall').attr("checked",false);	
}
function getsalesman(routeid,customerid)
{
	$('#ddlcustomer').html('');
	var  url = base_url+'/home/index/getgccustomerfromroutecode/routeid/'+routeid;
	$.ajax({
		url:url,
		data:$("#frmdet").serialize(),
		type:'post',		
		success:function(data) {
			var salesman_info = JSON.parse(data);
			if (salesman_info == '')
			{
				return false;
			}
			$('#txtsalesman').val(salesman_info[0][0]['salesmanname1']);
			$('#hdnsalesman').val(salesman_info[0][0]['salesmancode']);
			
			if(customerid == '')
			{
				$('#hdnmaxid').val(salesman_info[2][0]['lastid']);			
				var doc_invo = routeid+''+$('#hdnmaxid').val();
				$('#txtdoc_no').val(doc_invo);
				$('#txtinvo_no').val(doc_invo);
			}
			
			if(typeof(salesman_info[1]) == 'object')
			{
				$('<option/>').val('').html('--- Select ---').appendTo('#ddlcustomer');
				for (i=0;i<salesman_info[1].length;i++) {
					if(customerid > 0 && customerid == salesman_info[1][i]['id']) {
						$('<option selected />').val(salesman_info[1][i]['id']).html(salesman_info[1][i]['val']).appendTo('#ddlcustomer');
					}
					else {
						$('<option/>').val(salesman_info[1][i]['id']).html(salesman_info[1][i]['val']).appendTo('#ddlcustomer');
					}
				}
			}
			$('#ddlcustomer').trigger('liszt:updated');
		}
	})
}
function getinvoicetotal(ids)
{
	$('#txtinvo_amount').val('');
	$('#txtamount_paid').val('');
	$('#txtbal_amount').val('');
	$('#hdntotalinvoamt').val('');
	
	var  url = base_url+'/account/transaction/getinvoicetotal/invoiceid/'+ids;
	
	$.ajax({
		url:url,
		type:'post',
		data:$("#frmdet").serialize(),
		success:function(data) {
			var invoice_info = JSON.parse(data);			
			if(typeof(invoice_info) == 'object')
			{
				$('#hdntotalinvoamt').val(invoice_info[2]);
				$('#txtinvo_amount').val(invoice_info[0]);
				//$('#txtamount_paid').val(invoice_info[1]);
				$('#txtbal_amount').val(invoice_info[2]);
				
				if($('#chkfirstout').attr('checked')) {
					$('#txtamount').val(invoice_info[2]);					
				}
			}
			else
			{
				return false;
			}
		}
	})
}
