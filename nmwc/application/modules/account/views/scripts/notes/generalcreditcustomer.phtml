function paymodeoption(paymode)
{
	if(paymode == 0)	{
		$('#txtcheckno').val('');
		$('#txtcheckdt').val('');
		$('#ddlbankname').val('');
		
		$('#txtcheckno').attr('readonly',true);
		$('#txtcheckdt').attr('readonly',true);
		$('#ddlbankname').attr('disabled',true);
		
		$("#txtcheckdt").datepicker("disable");
		$('#txtcheckno').removeClass('required');
		$('#txtcheckdt').removeClass('required');
		$('#ddlbankname').removeClass('required');
		
		$('#lblbanknm span').html('');
		$('#lblbanknm span').html('&nbsp;:');
		$('#lblchkno span').html('');
		$('#lblchkno span').html('&nbsp;:');
		$('#lblchkdt span').html('');
		$('#lblchkdt span').html('&nbsp;:');
	}
	else {
		
		$( "#txtcheckdt" ).datepicker({
			dateFormat: 'dd-mm-yy'
		});
		$("#txtcheckdt").datepicker("enable");
		
		$('#txtcheckno').attr('readonly',false);
		$('#txtcheckdt').attr('readonly',false);
		$('#ddlbankname').attr('disabled',false);
		
		$('#txtcheckno').addClass('required');
		$('#txtcheckdt').addClass('required');
		$('#ddlbankname').addClass('required');
		
		$('#lblbanknm span').html('');
		$('#lblbanknm span').html('&nbsp;<font color="red">*</font>&nbsp;:');
		$('#lblchkno span').html('');
		$('#lblchkno span').html('&nbsp;<font color="red">*</font>&nbsp;:');
		$('#lblchkdt span').html('');
		$('#lblchkdt span').html('&nbsp;<font color="red">*</font>&nbsp;:');
	}
	$('#ddlbankname').trigger('liszt:updated');
}
