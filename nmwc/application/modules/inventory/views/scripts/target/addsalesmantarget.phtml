<script type="text/javascript">


	$(document).ready(function(){
		$(function() {
			
			
			
			$('#txtfromdate').attr('readonly',true);
			$('#txttodate').attr('readonly',true);
			
			$( "#txtfromdate" ).datepicker({
				dateFormat: 'dd-mm-yy'
			});
			$( "#txttodate" ).datepicker({
				dateFormat: 'dd-mm-yy'
			});			
			
			$("#txtfromdate").change(function() {
				var startDate = $('#txtfromdate').val();
				
				if(startDate == ''){
					return false;
				}
				
				$("#txttodate").datepicker( "option", "minDate",startDate);
				
				if($('#hdndayspotion').val() == 1){
					var date2 = $('#txtfromdate').datepicker('getDate', '+6d');
					date2.setDate(date2.getDate()+6);
					
					var from_date 	= $('#txtfromdate').datepicker('getDate', '+6d'),
						from_month 	= from_date.getMonth() + 1;
					
				} else if($('#hdndayspotion').val() == 2){
					var date2 = $('#txtfromdate').datepicker('getDate', '+32d');
					date2.setDate(date2.getDate()+32);
					
					var from_date 	= $('#txtfromdate').datepicker('getDate', '+32d'),
						from_month 	= from_date.getMonth() + 1;
				} else {
					jAlert('Please select Salesman');
					$('#txtfromdate').val('');
					$('#txttodate').val('');
					return false;
				}
				
				$('#txttodate').datepicker('setDate', date2);
				
				
					
				var to_date 	= $('#txttodate').datepicker('getDate'),
					to_month 	= to_date.getMonth() + 1;
					
				if(parseInt(from_month) < parseInt(to_month)){
					if($('#hdndayspotion').val() == 1){
						var date = $('#txtfromdate').datepicker('getDate', '+6d');
					} else {
						var date = $('#txtfromdate').datepicker('getDate', '+32d');
					}
					date.setMonth(date.getMonth() + 1, 0);
					$('#txttodate').datepicker('setDate',date);
				}
			});
			
			$("#txttodate").change(function() {
				var endDate = $('#txttodate').val();
				$("#txtfromdate").datepicker( "option", "maxDate",endDate);
			});
		
			$.datepicker.setDefaults({
				changeYear:true,
				changeMonth:true,
				yearRange: '-10:+15'
			});
		});
		$("#btnsave").click(function() {
		
			if( '<?php echo $this->params["id"];?>' > 0)
			{
			countGridDataSubmit('<?php echo $this->formdata['salesmancode'];?>');
			}
			else
			{
			countGridDataSubmit($('#hdnsalesmancode').val());
			}
							
			
			$('#fromdate').addClass('required');
			$('#todate').addClass('required');
			
			
			$('#ddlsalesman').addClass('required');
			
			//$('#ddltype').addClass('required');
						
			$('select').trigger('liszt:updated');
			
		});
		<?php if($this->params["id"] > 0) { ?>
			$('#ddlsalesman').attr("disabled", true);
			$('#ddlsalesman').trigger('liszt:updated');
