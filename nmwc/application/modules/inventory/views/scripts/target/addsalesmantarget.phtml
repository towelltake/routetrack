			loaddata('<?php echo $this->itemgrid.'/key/'.$this->formdata['salesmancode'];?>','item-grid');
			$('#txtroute').val('<?php echo $this->formdata['routename'];?>');
			$('#hdnroutecode').val('<?php echo $this->formdata['routecode']?>');
			$('#hdndayspotion').val('<?php echo $this->formdata['salesmantargetdays']?>');
			$('#ddlsalesman').val('<?php echo $this->formdata['salesmancode'];?>');
			//$('#ddltype').val('<?php echo $this->formdata['targettype'];?>');
			$('select').trigger('liszt:updated');
			
			
		<?php } 
		else{?>
		$('#ddlsalesman').attr("disabled", false);
		$('#ddlsalesman').trigger('liszt:updated');
		$('#hdnsalesmancode').val('');
		$('#hdntargetvalue').val('');
		<?php }
		?>
		
		
		
		
		$('#btnaddsalesman').click(function() {
			
			$('#ddlitempackage').addClass('required');
			$('#txtfromdate').addClass('required');
			$('#txttodate').addClass('required');
			$('#txtquantity').addClass('required');
			$('#txtcomval1').addClass('required');
			$('#txtcomval2').addClass('required');			
			
			$('#ddltype').addClass('required');
			
			/*Following new code added by nilesh for new Target on select on 14-June-2016 */
			var ddl_type = $('#ddltype').val();
			$('#ddltype').trigger('liszt:updated');
			var pckg_type = $('#ddlitempackage').val();			
			if(ddl_type =="3" || ddl_type =="4" || ddl_type =="5")
			{
				if(pckg_type != "1")
				{
					jAlert("Select Target Group as 'No PACKAGE' ");
					return false;
				}
			}
			else{
				
				if(pckg_type == "1")
				{
					jAlert("Select Target Group");
					return false;
				}
				
			}
			/*End new code added by nilesh for new Target on select on 14-June-2016 */
			
			if(!$("#frmdet").valid()){
				return false;
			}
			
			var  url = base_url+"/inventory/target/salesmanmonthlytargetgrid/key/"+$('#ddlsalesman').val();
			var values = $('#frmdet').serialize();
			//alert(values+'&add=yes&key='+$('#ddlsalesman').val());
				$.ajax({
					url:url,
					data :values+'&add=yes',
					type:'post',		
					success:function(data) {
						
						$('#item-grid').html(data);
						
						clearcontrol();
					}
			})			
		});
		
		$('#ddlsalesman').change(function() {
			
			var sid = $('#ddlsalesman').val();
			
			if(sid > 0)
			{
				var  url = base_url+"/inventory/target/getroutenamefromsalesman/sid/"+sid;
				$.ajax({
					url:url,
					data:$("#frmdet").serialize(),
					type:'post',		
					success:function(data) {	
					
						var routeinfo = JSON.parse(data);
						if (routeinfo == '')
						{
						
							return false;
						}
						var target_type = routeinfo[1][0]['targettype'];
						//$('#ddltype').val(target_type);
						countGridData(sid);
												
						
						$('#txtroute').val(routeinfo[0][0]['routename']);
						$('#hdnroutecode').val(routeinfo[0][0]['routecode']);
						$('#hdndayspotion').val(routeinfo[0][0]['salesmantargetdays']);
						clearcontrol();
						$('#ddltype').attr("disabled", false);
						$('#ddltype').trigger('liszt:updated');
						loaddata('<?php echo $this->itemgrid.'/key/'?>'+$('#ddlsalesman').val(),'item-grid');
						
						
						
					}
				})
			}
			else
			{
				$('#txtroute').val('');
				$('#hdnroutecode').val('');
				$('#hdndayspotion').val('');
				$('#hdnsalesmancode').val('');
				$('#hdntargetvalue').val('');
			}
		})
		
		$('#ddlitempackage').change(function() {
			
			var ipid = $('#ddlitempackage').val();
			
			if(ipid > 0)
			{
				var  url = base_url+"/inventory/target/getstatusofupcfromitempackage/ipid/"+ipid;
				$.ajax({
					url:url,					
					type:'post',		
					success:function(data) {
						var upcinfo = JSON.parse(data);						
						if(upcinfo == '1')
						{
							$('#chkiscase').attr('disabled',false);
							$('#chkiscase').attr('checked',false);
						}
						else
						{
							$('#chkiscase').attr('disabled',true);
							$('#chkiscase').attr('checked',false);
						}
					}
				})
			}
			else
			{
				$('#chkiscase').attr('checked',false);
				$('#chkiscase').attr('disabled',true);
			}
		})
		
		$('#txtdaily').change(function(){
			
			var daily_val = $('#txtdaily').val();
			
			$('#txtweekly').val((daily_val*6));
			$('#txtmonthly').val((daily_val*26))
			$('#txtyearly').val(((daily_val*26)*12));
		})
		
			$('#ddltype').change(function() {
			var targ_type = $('#ddltype').val();			
			
			if(targ_type =="3" || targ_type =="4" || targ_type =="5")
			{	
			$("#ddlitempackage").val("1");	
			$("#hdnpackvalue").val("1");	
			$("#ddlitempackage").attr("disabled", true);					
			$("#ddlitempackage").trigger('liszt:updated');		
			}
		else{			
			$("#ddlitempackage").attr("disabled", false);
			$("#ddlitempackage").trigger('liszt:updated');	
		}
		})
		
	})
function clearcontrol()
{
	$('#txtquantity').val('');
	$('#txtcomval1').val('');
	$('#txtcomval2').val('');
	$('#txtinsper').val('');
	$('#txtinsamt').val('');	
	$('#ddltype').val();
	$('#ddltype').trigger('liszt:updated');
				
	$('#ddlitempackage').val('');
	$('#chkiscase').attr('checked',false);
	$('select').trigger('liszt:updated');
	
	$('#txtfromdate').attr('readonly',true);
	$('#txttodate').attr('readonly',true);
	
	$( "#txtfromdate" ).datepicker({
		dateFormat: 'dd-mm-yy'
	});
	$( "#txttodate" ).datepicker({
		dateFormat: 'dd-mm-yy'
	});
	$('#txtfromdate').val('');
	$('#txttodate').val('');
	$.datepicker._clearDate('#txtfromdate');
	$.datepicker._clearDate('#txttodate');
}
function countGridData(sid)
{
			
			
			if(sid > 0)
			{
			
				var  url = base_url+"/inventory/target/getroutenamefromsalesman/sid/"+sid;
				$.ajax({
					url:url,
					type:'post',		
					success:function(data) {	
					
						var routeinfo_new = JSON.parse(data);						
						if (routeinfo_new == '')
						{						
							return false;
						}
						
							/*new condition added by nilesh on 10Apr2016*/
						var rec_count = routeinfo_new[1][0]['records_count'];					
						var target_type = routeinfo_new[1][0]['targettype'];
						$('#hdnsalesmancode').val(sid);
						$('#hdntargetvalue').val(target_type);
						
						if(rec_count!=0)
						{									
						//$('#ddltype').attr("disabled", true);
						$('#ddltype').trigger('liszt:updated');
						
						$('#ddlitempackage').removeClass('required');					
						$('#ddlitempackage').trigger('liszt:updated');
						
						
						$('#txtquantity').removeClass('required');
						
						
						$('#txtcomval1').removeClass('required');
						$('#txtcomval2').removeClass('required');
						$('#txtfromdate').removeClass('required');
						$('#txttodate').removeClass('required');
						$('#txtfromdate').removeClass('error');
						$('#txttodate').removeClass('error');
						$('#txtcomval1').removeClass('required');
						$("#frmdet").validate().form();
						
						
					
						}
						else{
						
						//$('#ddltype').attr("disabled", false);
						$('#ddltype').trigger('liszt:updated');
						$('#ddlitempackage').addClass('required');
						$('#txtfromdate').addClass('required');
						$('#txttodate').addClass('required');
						$('#txtquantity').addClass('required');
						$('#txtcomval1').addClass('required');
						
						
					
						
						}
												
					}
				})
				
			}
		
}


function countGridDataSubmit(sid)
{
			
			alert(sid);
			if(sid > 0)
			{
			
				var  url = base_url+"/inventory/target/getroutenamefromsalesman/sid/"+sid;
				$.ajax({
					url:url,
					type:'post',		
					success:function(data) {	
					
						var routeinfo_new = JSON.parse(data);						
						if (routeinfo_new == '')
						{						
							return false;
						}
						
							/*new condition added by nilesh on 10Apr2016*/
						var rec_count = routeinfo_new[1][0]['records_count'];					
						var target_type = routeinfo_new[1][0]['targettype'];
						$('#hdnsalesmancode').val(sid);
						$('#hdntargetvalue').val(target_type);						
						if(rec_count!=0)
						{									
					//	$('#ddltype').attr("disabled", true);
						$('#ddltype').trigger('liszt:updated');
						
						$('#ddlitempackage').removeClass('required');					
						$('#ddlitempackage').trigger('liszt:updated');
						
						
						$('#txtquantity').removeClass('required');
						
						
						$('#txtcomval1').removeClass('required');
						$('#txtcomval2').removeClass('required');
						$('#txtfromdate').removeClass('required');
						$('#txttodate').removeClass('required');
						$('#txtfromdate').removeClass('error');
						$('#txttodate').removeClass('error');
						$('#txtcomval1').removeClass('required');
						$("#frmdet").validate().form();
						$( "#frmdet" ).submit();
						
					
						}
						else{
						
						//$('#ddltype').attr("disabled", false);
						$('#ddltype').trigger('liszt:updated');
						$('#ddlitempackage').addClass('required');
						$('#txtfromdate').addClass('required');
						$('#txttodate').addClass('required');
						$('#txtquantity').addClass('required');
						$('#txtcomval1').addClass('required');
						$("#frmdet").validate().form();						
						$( "#frmdet" ).submit();
					
						
						}
						
					}
				})
				
			}
		
}

