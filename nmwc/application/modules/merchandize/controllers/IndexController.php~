    * @copyright  Elan Technologies
    * @param
    * This action is use for display customer images from public/customer folder
    */
    public function viewcustomerimagesAction() {
		
		$params = $this->getRequest()->getParams();
		
		if($params['id'] > 0) {
			
			$baseUrl            = Zend_Controller_Front::getInstance()->getBaseUrl();
			$this->view->path   = str_replace('//','/',$_SERVER['DOCUMENT_ROOT'].$baseUrl.'/public/customerimage/');
			$this->view->path1 	= str_replace('//','/',$baseUrl.'/public/customerimage/');
			$dirname 	        = $this->view->path;
			
			$Common_NameSpace = new Zend_Session_Namespace('CustomerImages');
			if($Common_NameSpace->date)
				$date = ' DATE(transactiondate) =  STR_TO_DATE("'.$Common_NameSpace->date.'","%d-%m-%Y")';
			
			$conditions[] = $params['id'];
			$conditions[] = $date;
			
			
			$images 			= $this->SFA_Comman->executequery('CALL sp_get_merchandize_index_customerimagesdatabyid(?)',$conditions);
			$this->view->images = $images[0];
			$this->view->title  = $this->translate->_('Customer Images');
			$this->view->message= $this->translate->_('No Record(s) Found');
			
		} else {
			$this->view->title  = $this->translate->_('Customer Images');
			$this->view->message= $this->translate->_('No Record(s) Found');
		}
    }
