    /**
    * @name       getlookindex
    * @since      18-05-2012
    * @version    Release: 2
    * @author     HD <hiren.d@elantechnologies.com>
    * @copyright  Elan Technologies
    * @param
    *
    * This action is use for getting value of the look index on the basis of the lookup Type
    */
       
    public function getlookindexAction()
    {
	
		$params = $this->getRequest()->getParams();
		
		if($params['id'] == 0)
		{
			$result = $this->SFA_Comman->executequery('CALL sp_combo_survey_lookupindex()','','');
			
			$str = '';	
			for($i=0;$i<count($result[0]);$i++) {
				
				$selected = '';
				if($params["lid"] == $result[0][$i]["id"]) { $selected = 'selected'; }
				
				$str .= '<option '. $selected .' value="'.$result[0][$i]['id'].'">'.$result[0][$i]['val'].'</option>';
			}
			
			$option =   '<label class="_36 margin_top_12 label_text_align">'.$this->translate->_('Lookup Index').''.$this->view->colan.'</label>
					<div class="_25 margin_right_1">
					<select id="ddllook_index" name="ddllook_index" class="required">
						<option value="">--- Select ---</option>
						'.$str.'
					</select>
					</div>
					<script type="text/javascript">
					if ($.fn.chosen) {
						$("select").chosen();
					}
					</script>';
				
			//'. if($this->formdata['lookupindex'] == $result[0][$i]['id'] )  { echo 'selected'; } '.
			echo $option;
			exit;
		}
		else
		{
			$option =   '<label class="_36 margin_top_12 label_text_align">'.$this->translate->_('Lookup Index').''.$this->view->colan.'</label>
					<div class="_25 margin_right_1">
					<select id="ddllook_index" name="ddllook_index" disabled="disabled">
						<option value="">--- Select ---</option>
					</select>
					</div>
					<script type="text/javascript">
					if ($.fn.chosen) {
						$("select").chosen();
					}
					</script>';
				
			//'. if($this->formdata['lookupindex'] == $result[0][$i]['id'] )  { echo 'selected'; } '.
			echo $option;
			exit;
		}
    }
	/**
    * @name       addlookupindex
    * @since      23-05-2012
    * @version    Release: 2
    * @author     HD
    * @copyright  Elan Technologies
    * @param
    *
    * This action is use for add information of the look up index
    * 
    */
    public function addlookupindexAction()
    {
		$this->_helper->layout->setLayout('popup');
		
		$this->view->params   = $params   = $this->getRequest()->getParams();        
		$this->view->formdata = $formdata = $this->_request->getPost();
		
		$this->view->defkey = (isset($params['defkey']) && $params['defkey'] !='') ? $params['defkey'] : $formdata['defkey'];
		
		$this->view->oi 	= (isset($params['oi']) && $params['oi'] !='') ? $params['oi'] : $formdata['hdnoi'];
		$this->view->sp 	= (isset($params['sp']) && $params['sp'] !='') ? $params['sp'] : $formdata['hdnsp'];		
		$this->view->st 	= (isset($params['st']) && $params['st'] !='') ? $params['st'] : $formdata['hdnst'];
		$this->view->lt		= (isset($params['lt']) && $params['lt'] !='') ? $params['lt'] : $formdata['hdnlt'];
		$this->view->li		= (isset($params['li']) && $params['li'] !='') ? $params['li'] : $formdata['hdnli'];
		$this->view->spa 	= (isset($params['spa']) && $params['spa'] !='') ? $params['spa'] : $formdata['hdnspa'];
		$this->view->status = (isset($params['status']) && $params['status'] !='') ? $params['status'] : $formdata['hdnstatus'];
		
		if($formdata['txtlk_desc'] !='' && $formdata['txtcode'] !='' )
		{
			
			$param_array 	= array();
			$param_array[1]	= $formdata['txtlk_desc'];
			$param_array[2]	= $formdata['txtarblk_desc'];
			$param_array[3]	= $this->currentUser->username;			
			
			if($formdata['hdnid1'] > 0)
			{
				$param_array[4] = $formdata['hdnid1'];				
				$last_id = $this->SFA_Comman->executequery('CALL sp_edit_merchandize_index_addlookupindex(?,?,?,?)',$param_array,'');
			}
			else
			{
				$last_id = $this->SFA_Comman->executequery('CALL sp_add_merchandize_index_addlookupindex(?,?,?)',$param_array,'');
			}
			
			$last_id = $last_id[0][0]['last_id'];
			$this->_helper->redirector('addlookupindex', 'index', 'merchandize',array('defkey'=>$this->view->defkey,'edit'=>'yes','trankey'=>$last_id,"addlookupindex"=>true,"oi"=>$this->view->oi,"sp"=>$this->view->sp,"st"=>$this->view->st,"lt"=>$this->view->lt,"li"=>$this->view->li,"spa"=>$this->view->spa,"status"=>$this->view->status));
		}
		elseif($params['trankey'] > 0)
		{
			$this->view->itemgrid   = $this->view->BaseUrl("/merchandize/index/lookupindexgrid/trankey/".$params['trankey']);
			$result = $this->SFA_Comman->executequery('CALL sp_get_merchandize_index_addlookupindex(?)',$params['trankey'],'');
			$this->view->formdata = $result[0][0];
		}
		else
		{
			$result = $this->SFA_Comman->executequery('CALL sp_get_merchandize_index_addlookupindex(?)','0','');
			$this->view->formdata['transactionkey'] = ($result[0][0]['Auto_increment'] == '') ? '1' : $result[0][0]['Auto_increment'];;			
		}
	}
	/**
    * @name       lookupindexgridAction
    * @since      23-05-2012
    * @version    Release: 2
    * @author     HD
    * @copyright  Elan Technologies
    * @param
    *
    * This action is use for display information of the look up index
    * 
    */
    public function lookupindexgridAction()
    {
		$this->view->params = $params = $this->getRequest()->getParams();

		// column to be fetched
		$columns_array 	=  array('description','arbdescription','primary_key as edit_del_primary_id');
		
		// column header to be displayed
		$columns_show  = array($this->translate->_('Description'),$this->translate->_('Description ('.$this->sec_lang.')'));
		
		
		// DELETE THE RECORD
		if($params["delete"]=="yes"){
			
			$param_array 	= array();
			$param_array[1]	= $params["id"];
			$param_array[2]	= $this->currentUser->username;
			
			// sp for delete outletproductitem
			$r_delete = $this->SFA_Comman->executequery('CALL sp_delete_merchandize_index_lookupindexgrid(?,?)',$param_array,'');
				SFA_Message::setMsg($this->translate->_('Delete Record'));
		}
	
		// UPDATE THE RECORD
		if($params["update"]=="yes")
		{
			
			if($params["description"] !='' && $params["arbdescription"] !='')
			{
				
				
				$updateData["1"] = trim($params["description"]);
				$updateData["2"] = trim($params["arbdescription"]);
				$updateData["3"] = $params["id"];
				
				// call sp for edit outletproductitem
				$r_edit = $this->SFA_Comman->executequery('CALL sp_edit_merchandize_index_lookupindexgrid(?,?,?)',$updateData,'');			
				SFA_Message::setMsg($this->translate->_('Update Record'));				
			}
			else
			{
				SFA_Message::setErrorMsg($this->translate->_('Missing Field'));
			}
		}
		
	
		// IF EXTRA PARAMS ARE REQUIRED
		$ex_param = "";
		if(isset($params["trankey"]) && $params["trankey"]>0)  {
			$additional_where_condition = array();
			$ex_param = "/trankey/".$params["id"];
				$additional_where_condition[] = ' ( transactionkey = "'.$params["trankey"].'" ) ';
		}
	
			// ARRAY FOR GRID PAGINATION
			$pagingparams = array(
						"show_grid_heading" => false,
						"grid_heading_message" => $this->translate->_('Overview'),
						"show_records_per_page" => isset($formdata["show_records_per_page"])?$formdata["show_records_per_page"]:10,
						"show_searchbox" => false,
						"show_selectbox" => false,
						"show_editlink" => true,
						"show_deletelink" => true,
						"show_deleteall" => false,
						"primaryid" => "primary_key",
						"currentlink" => array("/".$params['module']."/".$params['controller']."/".$params['action'].$ex_param),
						"deletelink" => array("/id/#pattern#/delete/yes","#pattern#"),
						"editlink" => array("/id/#pattern#/edit/yes","#pattern#"),
						"nodata_message" => $this->translate->_('No Record(s) Found'),
						"fetch_columns_inquery" => $columns_array,
						"show_columns" => $columns_show,
						"additional_where" => $additional_where_condition
						);
	
		// WHEN GRID IS IN EDIT MODE
		if($params["edit"]=="yes"){
	
			$pagingparams["editmode"] = true;
			$pagingparams["editmodeid"] = $params["id"];
			$pagingparams["editmodevalue"] = "primary_key";  // put table's prymary key here
		}
	
		//$pagingshow = new SFA_Pagingquery($pagingparams);
		$pagingshow = new SFA_Ajaxpaging($pagingparams);
		
		// call common function of grid class
		$get_return_vals = $pagingshow->commnfunc();
		
		// call the stored procedure for fetch the data
