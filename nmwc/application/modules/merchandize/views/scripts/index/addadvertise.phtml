    function changeadvertiseacl()
    {
	var code_id = $('#txtcode').val();
	var tempcode = $('#tempcode').val();
	var url = '<?php echo $add_advertise_img_grid; ?>';
	var data = "id="+code_id+"&tempcode="+tempcode;
	
	$.blockUI();
	$.ajax({
	    url:url,
	    data: data,
	    type:'post',
	    success:function(data) {
		$.unblockUI();
		$("#table-example").html(data);
	    }
	});
    }
    
    function deleteadvertiseimg(txtid)
    {
	var id = $('#txtcode').val();
	var tempcode = $('#tempcode').val();
	var url = '<?php echo $this->baseUrl(); ?>/merchandize/index/deleteadvertiseimg';
	var data = "id="+id+"&txtid="+txtid+"&tempcode="+tempcode;
	
	$.blockUI();
	$.ajax({
	    url:url,
	    data: data,
	    type:'post',
	    success:function(data) {
		$.unblockUI();
		changeadvertiseacl();
	    }
	});
    }
    
    $(document).ready(function() {
	$('#sbtnadd').click(function() {
	    
	    if($("#addimgform").valid())
	    {
		$("#addimgform").submit(); //Submit  the FORM
	    }
	    
	});
	
	$("#addimgform").submit(function(e)
	{
	    var formURL = $(this).attr("action");
	    var txtcode = $('#txtcode').val();
	    var tempcode = $('#tempcode').val();
	    
	    var data = new FormData(this);
	    data.append('txtcode',txtcode);
	    data.append('tempcode',tempcode);
	    
	    $.blockUI();
	    $.ajax(
	    {
		url : formURL,
		type: "POST",
		data : data,
		cache: false,
		contentType: false,
		processData: false,
		success:function(data, textStatus, jqXHR)
		{
		    $.unblockUI();
		    changeadvertiseacl();
		    $('#txtdesc').val('');
		    $('#imagefile').val('');
		    //data: return data from server
		},
		error: function(jqXHR, textStatus, errorThrown)
		{
		    //if fails     
		}
	    });
	    e.preventDefault(); //STOP default action
	    //e.unbind(); //unbind. to stop multiple form submit.
	});
	
	$('#btncancel').click(function() {
	    
	    var tempcode = $('#tempcode').val();
	    
	    if(tempcode)
	    {
		var url = '<?php echo $this->baseUrl(); ?>/merchandize/index/deleteadvertiseimg';
		var data = "tempcode="+tempcode;
		
		$.ajax({
		    url:url,
		    data: data,
		    type:'post',
		    success:function(data) {
			winloc('<?php echo $this->url(array("module"=>"merchandize","controller"=>"index","action"=>"advertise"),"default", true);?>');
		    }
		});
		
	    }
	    else
	    {
		winloc('<?php echo $this->url(array("module"=>"merchandize","controller"=>"index","action"=>"advertise"),"default", true);?>');
	    }
	});
    });
</script>

