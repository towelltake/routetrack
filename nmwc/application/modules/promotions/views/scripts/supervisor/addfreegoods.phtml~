	<?php } ?>
	
	$('#btnsave').click(function() {
		$('#ddl_itemcode').removeClass('required');
		$('#txt_freequantity').removeClass('required');
	});
	$("#sbtnadd").click(function() {
		
		$('#ddl_itemcode').addClass('required');
		$('#txt_freequantity').addClass('required');
		
		if($("#frmdetsec").valid())
		{
			$.ajax({
				type : "POST",
				url : base_url+"/promotions/customer/addfreegoodsgrid",
				data:$("#frmdetsec").serialize(),
				success:function(returndata){
					//$('#item-grid').html(returndata);
					loaddepotdatadata(base_url+"/promotions/customer/freegoodsgrid/key/"+returndata,'item-grid');
					$('#hdnid').val(returndata);
					$("#ddl_itemcode").val('');
					$("#txtupc").val('');
					$('#txt_freequantity').val('');
					$('select').trigger('liszt:updated');
					
					$("#item-grid #table-example tr").each(function() {
						if($(this).find('td').eq(4).html() == '0') {
							$(this).find('td').eq(5).find('a').html('');
							$(this).find('td').eq(6).find('a').html('');
						}
					})
				}
			});
		}
	});
	$("#ddl_depotcode").change(function() {
		var depotid = $('#ddl_depotcode').val();
		getcustomerdepotcode(depotid,'');
	});
	$("#ddl_itemcode").change(function() {
		
		var item_id = $("#ddl_itemcode").val();
		
		$("#txtupc").val('');
		
		if(item_id > 0 )
		{
			var url 		= base_url+'/home/index/getiteminfo/itemid/'+item_id;			
			$.ajax({
				url:url,				
				type:'post',
				beforeSend: function() {
					$("#loader").html("<img src='"+base_url+"/public/images/ajax-loader-bar.gif' alt='Loading..' />");	    
				},
				success:function(data)
				{	
					var item_info = JSON.parse(data);
					if (item_info == '')
					{
						return false;
					}					
					if(typeof(item_info[0]) == 'object')
					{
						$("#txtupc").val(item_info[0][0]['unitspercase']);						
						$("#loader").html("");
					}
				}
			})			
		}
	});
	
	
})
function getcustomerdepotcode(depotid,customerid)
{
	if(depotid > 0)
	{
		$("#ddl_customercode").html("");
		var values = $('#frmdetsec').serialize();
		$.ajax({
			type : "POST",
			url : base_url+"/home/index/getcustomerdepotcode/depotid/"+depotid,
			data :values,			
			success:function(data) {
				var customer_info = JSON.parse(data);
				if (customer_info == '')
				{
					return false;
				}
				if(typeof(customer_info[0]) == 'object')
				{
					$('<option/>').val('').html('--- Select ---').appendTo('#ddl_customercode');
					for (i=0;i<customer_info[0].length;i++) {
						if(customerid > 0 && customerid == customer_info[0][i]['id']) {
							$('<option selected />').val(customer_info[0][i]['id']).html(customer_info[0][i]['val']).appendTo('#ddl_customercode');
						}
						else {
							$('<option/>').val(customer_info[0][i]['id']).html(customer_info[0][i]['val']).appendTo('#ddl_customercode');
						}
					}
				}
				$('#ddl_customercode').trigger('liszt:updated');				
			}
		});
	}
	else
	{
		$("#ddl_customercode").html("");
		$('#ddl_customercode').trigger('liszt:updated');
	}
}
function fnload()
{	
	$("#item-grid #paging_grid #table-example tr").each(function() {
		if($(this).find('td').eq(4).html() < '0') {
			$(this).find('td').eq(6).html('---');
			$(this).find('td').eq(7).html('---');
		}
	})
}
