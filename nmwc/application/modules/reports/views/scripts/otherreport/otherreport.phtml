			$("#loader").html('');
		}
	});	
	

}


function addhidden()
{
    if($("#ddlfilterby").length > 0 && $("#ddlfilterby").val() != "")
    {
        if($("input[name='chk[]']:checked").length <= 0)
        {
            jAlert("Please Select "+$("#ddlfilterby option:selected").text());
            return false;
        }
    }
	 if($("#ddlfilterbycustomer").length > 0 && $("#ddlfilterbycustomer").val() != "")
    {
        if($("input[name='chk_customer[]']:checked").length <= 0)
        {
            jAlert("Please Select "+$("#ddlfilterbycustomer option:selected").text());
            return false;
        }
    }
	 if($("#ddlfilterbyitem").length > 0 && $("#ddlfilterbyitem").val() != "")
    {
        if($("input[name='chk_item[]']:checked").length <= 0)
        {
            jAlert("Please Select "+$("#ddlfilterbyitem option:selected").text());
            return false;
        }
    }
    return true;
}
function defaultHideFields()
{						$( "#route_area" ).hide();
						$( "#customer_area" ).hide();
						$( "#item_area" ).hide();
						$( "#fromdate_area" ).hide();
						$( "#todate_area" ).hide();
