			$("#loader").html("<img src='"+base_url+"/public/images/ajax-loader-bar.gif' alt='Loading..' />");	    
		},
		success:function(returndata){
			$('#customer-grid').html(returndata).removeAttr('style');
            if($('#customer-grid').height() > 200) {
                $('#customer-grid').css({"height":"200px","overflow-y":"auto"});
            }
            
			$("#loader").html('');
		}
	});	
}



function fillitemgrid(access_val)
{
	$('#item-grid').html('');
	var  url = '<?php echo $this->itemgrid; ?>'+'/key/'+access_val;
