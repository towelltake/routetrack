						var reportparameters = JSON.parse(data);
						var spname = reportparameters['reportsp'];
						var routecodeshow = reportparameters['routecode'];
						var customershow = reportparameters['customer'];
						var itemcodeshow = reportparameters['itemcode'];
						var fromdateshow = reportparameters['fromdate'];
						var todateshow = reportparameters['todate'];
						var groupbyshow = reportparameters['groupby'];	
						var report_name = reportparameters['reportname'];
						
						
					
						$("#hdnreportname").attr('value',report_name);
						$("#hdnspname").attr('value',spname);
						if(routecodeshow == "1")
						{
							$( "#route_area" ).show();
							ddlfilterby();	
						}
						else{
							$("#hdncount_route").attr('value',"1");						
						}
						
						if(customershow == "1")
						{
							$( "#customer_area" ).show();
							ddlfilterbycustomer();
							var showchannel = '<?php echo $this->showchannel; ?>';							
							if( showchannel == "false")
							$("#ddlfilterbycustomer option[value='2']").remove();
							$('#ddlfilterbycustomer').trigger('liszt:updated');
						}	
						else{
							$("#hdncount_customer").attr('value',"1");
						}
						if(itemcodeshow == "1")
						{
							$( "#item_area" ).show();
							ddlfilterbyitem();							
						}
						else{
							$("#hdncount_item").attr('value',"1");							
						}
						if(fromdateshow == "1")
						{
							$( "#fromdate_area" ).show();								
						}else{
							$("#hdncount_from").attr('value',"1");							
						}
						if(todateshow == "1")
						{
							$( "#todate_area" ).show();								
						}else{
							$("#hdncount_to").attr('value',"1");							
						}
						if(groupbyshow != "")
						{
							$("#hdngroupby").attr('value',groupbyshow);
						}else{
							$("#hdncount_groupby").attr('value',"1");							
						}
					}
				})
			
		});
	
		$('#ddlfilterby').change(function(){
			ddlfilterby();
	});
	function ddlfilterby()
	{
		var access_val = $('#ddlfilterby').val();
			if(access_val > 0) {
                $("#route-grid-div").show();
				filluseraccessgrid(access_val);
			}
			else {
                $("#route-grid-div").hide();
				$('#route-grid').html('').removeAttr('style');
			}
	}
	$('#ddlfilterbycustomer').change(function(){
		
		ddlfilterbycustomer();
	});
	function ddlfilterbycustomer()
	{
		var access_val = $('#ddlfilterbycustomer').val();
			if(access_val > 0) {
                $("#customer-grid-div").show();
				fillcustomergrid(access_val);
			}
			else {
                $("#customer-grid-div").hide();
				$('#customer-grid').html('').removeAttr('style');
			}
	}
	
	$('#ddlfilterbyitem').change(function(){
		
		ddlfilterbyitem();
	});
	function ddlfilterbyitem()
	{
			var access_val = $('#ddlfilterbyitem').val();
			if(access_val > 0) {
                $("#item-grid-div").show();
				fillitemgrid(access_val);
			}
			else {
                $("#item-grid-div").hide();
				$('#item-grid').html('').removeAttr('style');
			}
	}
	
	
	
});
	
function filluseraccessgrid(access_val)
{
	$('#route-grid').html('');
	var  url = '<?php echo $this->routegrid; ?>'+'/key/'+access_val;
	$.ajax({
		url:url,
		data:{},
		type:'post',
		beforeSend: function() {
			$("#loader").html("<img src='"+base_url+"/public/images/ajax-loader-bar.gif' alt='Loading..' />");	    
		},
		success:function(returndata){
			$('#route-grid').html(returndata).removeAttr('style');
            if($('#route-grid').height() > 200) {
                $('#route-grid').css({"height":"200px","overflow-y":"auto"});
            }
            
			$("#loader").html('');
		}
	});	
	

}

function fillcustomergrid(access_val)
{
	$('#customer-grid').html('');
	var  url = '<?php echo $this->customergrid; ?>'+'/key/'+access_val;
	$.ajax({
		url:url,
		data:{},
		type:'post',
