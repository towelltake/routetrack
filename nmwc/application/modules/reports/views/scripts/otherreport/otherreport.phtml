$(document).ready(function() {
	
	 $('#ddlfilterbyreport').change(function(){
		 defaultHideFields();
				var DropVal = $('#ddlfilterbyreport').val();
				var url = base_url+"/reports/otherreport/reportparamlist/id/"+DropVal;
				var result;
				$.ajax({
					url:url,
					data:$("#thisform").serialize(),
					type:'post',
					beforeSend: function() {
						//$("#loader").html("<img src='"+base_url+"/public/images/ajax-loader-bar.gif' alt='Loading..' />");	    
					},
