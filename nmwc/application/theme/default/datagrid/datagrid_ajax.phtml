	function toggleChecked(status) {
		$('#table-example input:checkbox.sel_checkbox_all').each( function() {		
			$(this).attr("checked",status);
			
			var str 	= this.id;
			var substr 	= str.split('_');
			var t_id 	= 'extratextbox_'+substr[1];
			var mcCbxCheck = $(this);			
			if(mcCbxCheck.is(':checked')) {
				$('#'+t_id).attr('readonly',false);
			}
			else {
				$('#'+t_id).attr('readonly',true);
				$('#'+t_id).val('');
			}
		});
	}
	 
	function toggleUnChecked(status,val) {
		
		$('#chkall').attr("checked",false);

		var totalch = $("#table-example input:checkbox.sel_checkbox_all").size();
		var checkedch = $("#table-example input:checkbox.sel_checkbox_all:checked").size();
		
		if(status)
		{
		    if(checkedch==totalch)
				$('#chkall').attr("checked",true);
		}
	}
	
	function checkinvobal(val,tid)
	{
		var decimal_places = '<?php echo $this->decimalplaces; ?>';
		
		if(parseInt(val) > 0)
		{
			var substr 	= tid.split('_');
			var val1 =  $("#span_"+substr[1]).html();
				val1 =  val1.replace(',','');
				
			// span1 value
			var val2 =  $("#span1_"+substr[1]).html();
				val2 =  val2.replace(',','');
				val2 = parseFloat(val1) - parseFloat(val2);
			
			val = val.replace(',','');
			
			if(parseFloat(Math.abs(val)) > parseFloat(Math.abs(val2)))
			{
				$('#'+tid).val('');
				$('#'+tid).focus();
				jAlert('Amount Exceeds Present Balance.');
				$('#chk_'+substr[1]).attr('checked',false);
				$('#chkall').attr('checked',false);
				return false;
			}
			if(val2 > 0 && parseFloat(Math.abs(val)) > parseFloat(Math.abs(val2)))
			{
				$('#'+tid).val('');
				$('#'+tid).focus();
				jAlert('A PDC Is Collected Against The Invoice.');
				$('#chk_'+substr[1]).attr('checked',false);
				$('#chkall').attr('checked',false);
				return false;
			}
			if(parseFloat(Math.abs(val1)) < parseFloat(Math.abs(val)))
			{
				$('#'+tid).val('');
				$('#'+tid).focus();
				jAlert('Current Amount Must Be Lower Than The Present Amount.');
				return false;
			}
		}
	}
	
