	// remove content from strign (eg. remove id/2/delete/yes from string)
	function removeQS(str)
	{
		var xstr = '';
		
		//xstr = str.replace(/(\/id\/\d+\/(.*)\/yes)\.*/g, "");		
		//xstr = str.replace(/(\/id\/\d+\/).*/g, "");
		
		xstr = str.replace(/(\/id\/(\d+_\d+|\d+)\/).*/g, "");
		return xstr;		
	}
	function urlReplace(xurl,xfind,yreplace)
	{
		return xurl.replace(xfind, yreplace);
	}
	
	function searchbox(obj) {
		if(obj == 'hide') {
		    $('#draggable').hide();
		    $('#table-searchall').show();
		    $('#table-showpages').show();
		    
		} else {
		    $('#draggable').show();
		    $('#table-searchall').hide();
		    $('#table-showpages').hide();
		}
	}
	
