			{
				if(resp) {
					var xurl = removeQS(reqUrl) + del_id;
					//var xurl = removeQS(reqUrl) + '/id/9999999/delete/yes';
					loaddata(xurl,"item-grid");
				}
			})			
		});
		
		$('#paging_grid .xedit').click(function(){
			
			var xurl = removeQS(reqUrl) + this.id;
			loaddata(xurl,"item-grid");
		});
		
		$('#btnupdate_grid').click(function(){
			
			
			
			var callUrl = urlReplace(reqUrl,'/edit/', '/update/');
			
			var xdata = '';
			// fetch all check box values
			$('.update_vals').each(function(){
				
				xdata = xdata + this.id + '=' + this.value + '&';
			});
			
			$.ajax({
				url:callUrl,
				data: xdata,
				success:function(data){
				    $("#item-grid").html(data);
				    
				  
				}
			})
		});
		
		$('#btncancel_grid').click(function(){
			
			xurl = removeQS(reqUrl);
			loaddata(xurl,"item-grid");
		});
		
		$(".alert .hide").click(function() {
			$(this).parent().slideUp();
		});
		
