		$('#paging_grid .page_number').click(function(){
		   
		   var xurl = removeQS(this.id);
		   loaddata(xurl,'item-grid');
	        });
		
		$('#paging_grid .icodel').click(function(){
			var del_id = '';
			del_id   = this.id;
			
